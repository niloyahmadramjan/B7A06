						"url": "{{baseUrl}}/api/v1/service-visits/{{visitId}}"
					}
				},
				{
					"name": "Complete Visit (IN_PROGRESS -> COMPLETED, work order auto-COMPLETED)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"COMPLETED\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/service-visits/{{visitId}}"
					}
				},
				{
					"name": "Delete Service Visit",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": "{{baseUrl}}/api/v1/service-visits/{{visitId}}"
					}
				}
			]
		},
		{
			"name": "Invoices",
			"description": "Create/Update/Delete by Admin/Manager, view by Admin/Manager/Customer. Amount is auto-calculated as Service Price + (actualCost ?? estimatedCost ?? 0) unless an explicit amount is sent. Authenticated with accessToken.",
			"item": [
				{
					"name": "Create Invoice",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"  pm.collectionVariables.set('invoiceId', pm.response.json().data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
