{
	"info": {
		"name": "Field Service System API",
		"description": "Complete API collection for the Field Service System. Run Register/Login first to save the access and refresh tokens as collection variables, then run each folder in flow order: Services -> Service Requests (Customer creates, Manager approves/rejects) -> Assignments (Manager assigns technician directly) -> Service Visits (Schedule, Technician Arrives/Starts, Work Completed) -> Invoices. Completing a visit auto-completes the work order; payment & feedback are added later. Resource IDs are captured automatically via test scripts. Applicants register as customers, apply via Technicians -> Apply as Technician, then an Admin/Manager approves or rejects.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "serviceId",
			"value": ""
		},
		{
			"key": "requestId",
			"value": ""
		},
		{
			"key": "workOrderId",
			"value": ""
		},
		{
			"key": "customerId",
			"value": ""
		},
		{
			"key": "technicianId",
			"value": ""
		},
		{
			"key": "assignmentId",
