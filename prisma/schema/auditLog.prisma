model AuditLog {
  id String @id @default(uuid())

  actorId String?
  action  String
  entity  String
  entityId String?

  changes Json?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
}
